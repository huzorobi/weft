# Weft configuration — FREE keys only. Never add a paid key.
# A module whose free key is missing disables itself and says so; it never crashes.

# Graph store (Neo4j Community).
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# Metadata + audit store. SQLite for local dev, Postgres in the compose stack.
DATABASE_URL=sqlite:///weft-dev.db
# DATABASE_URL=postgresql+psycopg://weft:weft@postgres:5432/weft

# Self-hosted search — no key, no bill.
SEARXNG_URL=http://searxng:8080

# Free keys (all free to obtain, none paid).
COMPANIES_HOUSE_API_KEY=      # free: developer.company-information.service.gov.uk
GITHUB_TOKEN=                 # free personal access token, read-only public scope
OPENCORPORATES_API_KEY=       # free tier, optional
HIBP_API_KEY=                 # free tier ONLY — domain search on client-controlled domains

# Orchestrator.
DEPTH_DEFAULT=2

# Local reasoner (optional, LOCAL ONLY — never a hosted model; personal data stays in the estate).
OLLAMA_URL=http://localhost:11434
REASONER_MODEL=llama3.2:3b        # small model, runs on an 8GB GPU; used only to narrate the graph

# Optional on-disk secrets file, chained after the environment (a vault provider slots in here).
SECRETS_FILE=

# Infrastructure-pivot sources (free registration keys).
URLSCAN_API_KEY=              # free account at urlscan.io (1000 searches/day)
OTX_API_KEY=                  # free account at otx.alienvault.com

# Dark-web search (opt-in, Tor). Requires a Tor SOCKS proxy; module self-disables without it.
DARKWEB_TOR_PROXY=socks5://127.0.0.1:9050
